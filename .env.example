F1_MLFLOW_TRACKING_URI=https://<f1-mlflow-host>/<path>
F1_MLFLOW_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
F2_MLFLOW_TRACKING_URI=https://<f2-mlflow-host>/<path>
F2_MLFLOW_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
F2_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
F2_CORPUS_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
F2_CATALOG_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# Dedicated disposable test database only; never point this at production.
# Leave unset to create a temporary PostgreSQL 18 container during DB tests.
# F2_TEST_DATABASE_URL=postgresql://<test-user>:<test-password>@<test-host>:5432/<test-database>

F2_CORPUS_S3_ENDPOINT=https://<s3-host>:<port>
F2_CORPUS_S3_ROOT=s3://<corpus-bucket>/<optional-prefix>
F2_CORPUS_S3_ACCESS_KEY=<corpus-access-key>
F2_CORPUS_S3_SECRET_KEY=<corpus-secret-key>
F2_CORPUS_S3_REGION=us-east-1
F2_GIGAWORD_S3_ENDPOINT=https://<restricted-s3-host>:<port>
F2_GIGAWORD_S3_ROOT=s3://<restricted-bucket>/<optional-prefix>
F2_GIGAWORD_S3_ACCESS_KEY=<restricted-access-key>
F2_GIGAWORD_S3_SECRET_KEY=<restricted-secret-key>
F2_GIGAWORD_S3_REGION=us-east-1
